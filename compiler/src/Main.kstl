/*
 * The compiler's entry point: `ksc run File.kstl` reads the file and
 * prints its tokens, one per line, in the same format as
 * `ksc File.kstl --tokens`.
 *
 * A `Diagnostic` from the lexer is printed as `error: ...` and the
 * program exits with status 1.
 *
 * @since 0.8
 * @author Edynu
 */

use std.io.Files;
use std.io.Console;
use std.os.Process;
use std.text.Texts;
use std.text.Chars;

use lexer.Lexer;
use lexer.Token;
use lexer.TokenKind;
use diag.Diagnostic;
use diag.Reporter;
use parser.Node;
use parser.NodeKind;
use parser.Parser;

proc main() {
    if !Files.exists(Process.arg(0)) {
        Console.printf("File does not exist: %s\n", Process.arg(0));
        Process.exit(1);
    }
    source: text = Files.read(Process.arg(0));
    tokensOnly: bool = Process.argCount() > 1 && Process.arg(1) == "--tokens";
    if !tokensOnly {
        try {
            parser: Parser = Parser(source);
            tree: Node = parser.parse();
            Console.printl(show(&tree, source));
            burn tree;
            burn parser;
        } catch error: Diagnostic {
            reporter: Reporter = Reporter(Process.arg(0), source);
            reporter.report(&error);
            burn reporter;
            burn error;
            Process.exit(1);
        }
    } else {
        lexer: Lexer = Lexer(source);
        try {
            lexer.run();
        } catch error: Diagnostic {
            reporter: Reporter = Reporter(Process.arg(0), source);
            reporter.report(&error);
            burn reporter;
            burn error;
            Process.exit(1);
        } catch failure: Trap {
            // A character outside the tryte table (such as `\r`) cannot be read.
            Console.printl("error: " + failure.message());
            burn failure;
            Process.exit(1);
        }

        for i: int = 0; i < lexer.tokens.len(); i++ {
            token: Token = lexer.tokens.get(i);
            Console.printl(padLeft(Texts.toText(token.start), 5) + ".." + padRight(Texts.toText(token.end), 5) + " " + describe(token, source));
        }
        burn lexer;
    }
}

proc describe(token: Token, source: text) -> text {
    word: text = Texts.sub(source, token.start, token.end);
    match token.kind {
        TokenKind.EndOfFile => return "end of file";
        TokenKind.Number => {
            // A `?` digit (`0t+?`) makes the number NaT.
            if Texts.indexOf(word, "?") >= 0 {
                return "number `NaT`";
            }
            return "number `" + Texts.toText(Texts.toInt(word) ?: 0) + "`";
        }
        TokenKind.RealNumber => return "real `" + Texts.toText(Texts.toReal(word) ?: 0.0) + "`";
        TokenKind.String => return "string literal";
        TokenKind.Character => return "character literal";
        // Names, keywords and symbols: their own text.
        else => return "`" + word + "`";
    }
}

proc padLeft(value: text, width: int) -> text {
    length: int = len(value);
    if length >= width {
        return value;
    }
    padding: text = "";
    while len(padding) < width - length {
        padding = padding + " ";
    }
    return padding + value;
}

proc padRight(value: text, width: int) -> text {
    length: int = len(value);
    if length >= width {
        return value;
    }
    padding: text = "";
    while len(padding) < width - length {
        padding = padding + " ";
    }
    return value + padding;
}

proc symbol(kind: TokenKind) -> text {
    match kind {
        TokenKind.Plus => return "+";
        TokenKind.Minus => return "-";
        TokenKind.Star => return "*";
        TokenKind.Slash => return "/";
        TokenKind.Percent => return "%";
        TokenKind.Equal => return "=";
        TokenKind.PlusEqual => return "+=";
        TokenKind.MinusEqual => return "-=";
        TokenKind.StarEqual => return "*=";
        TokenKind.SlashEqual => return "/=";
        TokenKind.PercentEqual => return "%=";
        TokenKind.PlusPlus => return "++";
        TokenKind.MinusMinus => return "--";
        TokenKind.EqualEqual => return "==";
        TokenKind.NotEqual => return "!=";
        TokenKind.Less => return "<";
        TokenKind.Greater => return ">";
        TokenKind.LessEqual => return "<=";
        TokenKind.GreaterEqual => return ">=";
        TokenKind.Spaceship => return "<=>";
        TokenKind.AndAnd => return "&&";
        TokenKind.OrOr => return "||";
        TokenKind.Elvis => return "?:";
        TokenKind.Bang => return "!";
        TokenKind.Dot => return ".";
        TokenKind.Ampersand => return "&";
        else => return "?";
    }
}

proc showList(label: text, node: &Node, source: text) -> text {
    result: text = "(" + label;
    for i: int = 0; i < node.children.len(); i++ {
        result = result + " " + show(node.children.get(i), source);
    }
    return result + ")";
}

proc show(node: &Node, source: text) -> text {
    if node.kind == NodeKind.Block {
        result: text = "(block";
        for i: int = 0; i < node.children.len(); i++ {
            result = result + " " + show(node.children.get(i), source);
        }
        return result + ")";    
    }
    if node.kind == NodeKind.Call {
        return showList("call", &node, source);
    }
    if node.kind == NodeKind.Program {
        return showList("program", &node, source);
    }
    if node.kind == NodeKind.Use {
        return showList("use", &node, source);
    }
    if node.kind == NodeKind.Public {
        return showList("public", &node, source);
    }
    if node.kind == NodeKind.Const {
        return showList("const", &node, source);
    }
    if node.kind == NodeKind.Class {
        return showList("class", &node, source);
    }
    if node.kind == NodeKind.Struct {
        return showList("struct", &node, source);
    }
    if node.kind == NodeKind.ClassField {
        return "(field " + show(node.children.get(0), source) + " " + show(node.children.get(1), source) + ")";
    }
    if node.kind == NodeKind.Enum {
        return showList("enum", &node, source);
    }
    if node.kind == NodeKind.EnumItem {
        if node.children.len() == 1 {
            return "(" + show(node.children.get(0), source) + ")";
        }
        return "(" + show(node.children.get(0), source) + " " + show(node.children.get(1), source) + ")";
    }
    if node.kind == NodeKind.Proc {
        return showList("proc", &node, source);
    }
    if node.kind == NodeKind.Parameters {
        return showList("params", &node, source);
    }
    if node.kind == NodeKind.Borrow {
        return "(" + symbol(node.operator) + " " + show(node.children.get(0), source) + ")";
    }
    if node.kind == NodeKind.Give {
        return "(give " + show(node.children.get(0), source) + ")";
    }
    if node.kind == NodeKind.Burn {
        return "(burn " + show(node.children.get(0), source) + ")";
    }
    if node.kind == NodeKind.Parameter {
        return "(param " + show(node.children.get(0), source) + " " + show(node.children.get(1), source) + ")";
    }
    if node.kind == NodeKind.Throws {
        result: text = "(throws";
        for i: int = 0; i < node.children.len(); i++ {
            result = result + " " + show(node.children.get(i), source);
        }
        return result + ")";
    }
    if node.kind == NodeKind.Return{
        return "(return " + show(node.children.get(0), source) + ")";
    }
    if node.kind == NodeKind.Throw {
        return "(throw " + show(node.children.get(0), source) + ")";
    }
    if node.kind == NodeKind.If {
        result: text = "(if " + show(node.children.get(0), source) + " " + show(node.children.get(1), source);
        if node.children.len() == 3 {
            result = result + " " + show(node.children.get(2), source);
        }
        return result + ")";
    }
    if node.kind == NodeKind.Else {
        return showList("else", &node, source);
    }
    if node.kind == NodeKind.Try {
        result: text = "(try " + show(node.children.get(0), source);
        for i: int = 1; i < node.children.len(); i++ {
            result = result + " " + show(node.children.get(i), source);
        }
        return result + ")";
    }
    if node.kind == NodeKind.Catch {
        return showList("catch", &node, source);
    }
    if node.kind == NodeKind.Match {
        return showList("match", &node, source);
    }
    if node.kind == NodeKind.Arm {
        return showList("arm", &node, source);
    }
    if node.kind == NodeKind.While {
        return "(while " + show(node.children.get(0), source) + " " + show(node.children.get(1), source) + ")";
    }
    if node.kind == NodeKind.For {
        return "(for " + show(node.children.get(0), source) + " " + show(node.children.get(1), source) + " " + show(node.children.get(2), source) + " " + show(node.children.get(3), source) + ")";
    }
    if node.kind == NodeKind.Continue {
        return "(continue)";
    }
    if node.kind == NodeKind.Break {
        return "(break)";
    }
    if node.kind == NodeKind.ExpressionStatement {
        return show(node.children.get(0), source);
    }
    if node.kind == NodeKind.Unary {
        return "(" + symbol(node.operator) + " " + show(node.children.get(0), source) + ")";
    }
    if node.kind == NodeKind.Binary || node.kind == NodeKind.Field {
        return "(" + show(node.children.get(0), source) + " " + symbol(node.operator) + " " + show(node.children.get(1), source) + ")";
    }
    if node.kind == NodeKind.Assignment {
        if node.children.len() == 1 {
            return "(" + show(node.children.get(0), source) + symbol(node.operator) + ")";
        }
        return "(" + show(node.children.get(0), source) + " " + symbol(node.operator) + " " + show(node.children.get(1), source) + ")";
    }
    if node.kind == NodeKind.Declaration {
        return showList("let", &node, source);
    }
    if node.kind == NodeKind.Type && node.children.len() > 0 {
        end: int = node.start;
        while end < node.end && (Chars.isLetter(source[end]) || Chars.isDigit(source[end]) || source[end] == '_') {
            end++;
        }
        return showList(Texts.sub(source, node.start, end), &node, source);
    }
    if node.kind == NodeKind.Index {
        return showList("index", &node, source);
    }
    if node.kind == NodeKind.Name && node.operator == TokenKind.LeftBracket {
        return Texts.sub(source, node.start, node.end) + "[]";
    }
    if node.kind == NodeKind.ArrayLiteral {
        return showList("array", &node, source);
    }
    if node.kind == NodeKind.Claim {
        return showList("claim", &node, source);
    }
    if node.kind == NodeKind.Optional {
        return "?" + show(node.children.get(0), source);
    }
    if node.kind == NodeKind.ArrayType {
        return showList("array-type", &node, source);
    }
    return Texts.sub(source, node.start, node.end);
}
