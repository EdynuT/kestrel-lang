        return "// Copyright (c) 2026 Edynu\n// SPDX-License-Identifier: GPL-3.0-or-later\n\n/*\n * Characters (`tryte`): what kind each one is.\n *\n * @since 0.7\n * @author Edynu\n * @see Chars.isDigit\n * @see Chars.isLetter\n * @see Chars.isUpper\n * @see Chars.isLower\n * @see Chars.isSpace\n */\n\n/*\n * Checks if a character is a digit (`0`..`9`). */\npublic native proc isDigit(c: tryte) -> bool;\n\n/* Checks if a character is a letter (`a`..`z`, `A`..`Z`). */\npublic native proc isLetter(c: tryte) -> bool;\n\n/* Checks if a character is an uppercase letter (`A`..`Z`). */\npublic native proc isUpper(c: tryte) -> bool;\n\n/* Checks if a character is a lowercase letter (`a`..`z`). */\npublic native proc isLower(c: tryte) -> bool;\n\n/* Checks if a character is a whitespace character (space, tab, newline, etc.). */\npublic native proc isSpace(c: tryte) -> bool;\n";
    }
    if name == "text.TextBuilder" {
        return "// Copyright (c) 2026 Edynu\n// SPDX-License-Identifier: GPL-3.0-or-later\n\n/*\n * Builds a text piece by piece: the characters are kept in an array, and\n * the text is made once, at the end (`+` copies the whole text every time).\n *\n * @since 0.7\n * @author Edynu\n * @see TextBuilder.toText\n * @see TextBuilder.add\n * @see TextBuilder.addChar\n * @see TextBuilder.len\n * @see TextBuilder.build\n */\n\nuse std.text.Texts;\n\npublic class TextBuilder {\n    chars[]: tryte;\n\n    /* An empty builder: `TextBuilder()`. */\n    public proc TextBuilder() -> TextBuilder {\n        empty[]: tryte = {};\n        return TextBuilder { chars: give empty };\n    }\n\n    /* Puts every character of `value` at the end. */\n    public proc add(&self, value: text) {\n        walk i in 0..len(value) - 1 {\n            append(self.chars, value[i]);\n        }\n    }\n\n    /* Puts a single character at the end. */\n    public proc addChar(&self, char: tryte) {\n        append(self.chars, char);\n    }\n\n    /* Returns the number of characters accumulated so far. */\n    public proc len(&self) -> int {\n        return len(self.chars);\n    }\n\n    /* Builds the final text from the accumulated characters. */\n    public proc build(&self) -> text {\n        return Texts.toText(self.chars, 'c');\n    }\n}\n";
    }
    if name == "text.Texts" {
        return "// Copyright (c) 2026 Edynu\n// SPDX-License-Identifier: GPL-3.0-or-later\n\n/*\n * Text-related utility functions.\n *\n * @since 0.7\n * @author Edynu\n * @see Texts.startsWith\n * @see Texts.endsWith\n * @see Texts.indexOf\n * @see Texts.trim\n * @see Texts.split\n * @see Texts.strip\n */\n\nuse std.collections.List;\nuse std.text.Chars;\n\n/* Extracts a substring from `value` starting at `start` and ending before `end`. */\npublic native proc sub(value: text, start: int, end: int) -> text;\n\n/* Converts `value` to an integer, if possible. */\npublic native proc toInt(value: ...) -> int?;\n\n/* Converts `value` to a real number, if possible. */\npublic native proc toReal(value: ...) -> real?;\n\n/* Converts `value` to text. */\npublic native proc toText(value: ...) -> text;\n\n/* Searches for substrings and checks prefixes/suffixes. */\npublic proc startsWith(value: text, prefix: text) -> bool {\n    if len(prefix) > len(value) {\n        return false;\n    }\n    walk i in 0..len(prefix) - 1 {\n        if value[i] != prefix[i] {\n            return false;\n        }\n    }\n    return true;\n}\n\n/* Checks if `value` ends with `suffix`. */\npublic proc endsWith(value: text, suffix: text) -> bool {\n    if len(suffix) > len(value) {\n        return false;\n    }\n    walk i in 0..len(suffix) - 1 {\n        if value[len(value) - len(suffix) + i] != suffix[i] {\n            return false;\n        }\n    }\n    return true;\n}\n\n/* Finds the first occurrence of `sub` in `value`, or -1 if not found. */\npublic proc indexOf(value: text, sub: text) -> int {\n    walk i in 0..len(value) - len(sub) {\n        found: bool = true;\n        walk j in 0..len(sub) - 1 {\n            if value[i + j] != sub[j] {\n                found = false;\n                break;\n            }\n        }\n        if found {\n            return i;\n        }\n    }\n    return -1;\n}\n\n/* Trims leading and trailing spaces from `value`. */\npublic proc trim(value: text) -> text {\n    start: int = 0;\n    end: int = len(value) - 1;\n    while start <= end && Chars.isSpace(value[start]) {\n        start = start + 1;\n    }\n    while end >= start && Chars.isSpace(value[end]) {\n        end = end - 1;\n    }\n    return sub(value, start, end + 1);\n}\n\n/* Splits `value` into a list of substrings separated by `delimiter`. */\npublic proc split(value: text, delimiter: text) -> List<text> {\n    result: List<text> = List<text>();\n    // An empty delimiter is found everywhere: the text stays whole.\n    if len(delimiter) == 0 {\n        result.add(value);\n        return result;\n    }\n    start: int = 0;\n    while true {\n        rest: text = sub(value, start, len(value));\n        position: int = indexOf(rest, delimiter);\n        if position == -1 {\n            result.add(rest);\n            return result;\n        }\n        result.add(sub(value, start, start + position));\n        start = start + position + len(delimiter);\n    }\n    return result;\n}\n\n/* Strips all characters in `chars` from the start and end of `value`. */\npublic proc strip(value: text, chars: text) -> text {\n    start: int = 0;\n    end: int = len(value) - 1;\n    while start <= end && indexOf(chars, sub(value, start, start + 1)) != -1 {\n        start = start + 1;\n    }\n    while end >= start && indexOf(chars, sub(value, end, end + 1)) != -1 {\n        end = end - 1;\n    }\n    return sub(value, start, end + 1);\n}\n";
    }
    return null;
