/*
 * What a node of the syntax tree is: a number, a name, an operation
 * between two expressions, and later statements and declarations.
 *
 * The parser builds every node with the same class (`Node`), so this
 * kind is what tells them apart; it grows with each part of the
 * language the parser learns.
 *
 * @since 0.8
 * @author Edynu
 */

public enum NodeKind {
    Number,
    Name,
    Binary,
    Unary,
    Block,
    Return,
    ExpressionStatement,
    Declaration,
    Type,
    Assignment,
    If,
    While,
    For,
    Continue,
    Break,
    Program,
    Proc,
    Parameters,
    Parameter,
    Call,
    Field,
    Literal,
    Use,
    Public,
    Enum,
    EnumItem,
    Class,
    ClassField,
    Borrow,
    Throws,
    Give,
    Burn,
    Try,
    Catch,
    Throw,
    Match,
    Arm,
    Else,
    Index,
    ArrayLiteral,
    Claim,
    Optional,
    ArrayType,
    Const,
    Struct,
    Interface,
    Signature,
    Annotation,
    Annotated,
    Object,
    FieldValue,
    Walk,
    Range,
    Span,
    Tri,
    TriArm,
    Cast,
    Final,
    Native,
    Variadic,
    Generics
}
