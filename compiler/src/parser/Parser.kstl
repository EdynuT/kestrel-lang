/*
 * Builds the syntax tree (`Node`) from the tokens of the source code.
 *
 * It runs the lexer itself and walks its tokens one at a time, as the
 * lexer walks the characters: `current()` is the token it is looking
 * at, `advance()` moves to the next one and `expect()` requires a
 * kind of token. Operations are read by precedence, so in `1 + 2 * 3`
 * the `*` ends up deeper in the tree than the `+`. Code that does not
 * fit the grammar throws a `Diagnostic`.
 *
 * @since 0.8
 * @author Edynu
 */

use std.collections.List;

use lexer.Token;
use lexer.TokenKind;
use lexer.Lexer;
use diag.Diagnostic;
use parser.Node;
use parser.NodeKind;

public class Parser {
    source: text;
    lexer: Lexer;
    position: int;
    
    public proc Parser(source: text) -> Parser throws Diagnostic {
        lexer: Lexer = Lexer(source);
        lexer.run();
        return Parser { source: source, lexer: give lexer, position: 0};
    }

    public proc parse(&self) -> Node throws Diagnostic {
        start: int = self.current().start;
        children: List<Node> = List<Node>();
        while self.current().kind != TokenKind.EndOfFile {
            children.add(self.procedure());
        }
        end: int = self.current().end;
        return Node(NodeKind.Program, start, end, TokenKind.EndOfFile, give children);
    }

    proc current(&self) -> Token {
        return self.lexer.tokens.get(self.position);
    }

    proc peek(&self, offset: int) -> Token {
        index: int = self.position + offset;
        last: int = self.lexer.tokens.len() - 1;
        if index > last {
            index = last;
        }
        return self.lexer.tokens.get(index);
    }

    proc advance(&self) {
        if self.current().kind != TokenKind.EndOfFile {
            self.position++;
        }
    }

    /* Reads the current token if it is `kind`; `what` names it in the error: "`)`". */
    proc expect(&self, kind: TokenKind, what: text) throws Diagnostic {
        if self.current().kind != kind {
            throw Diagnostic("expected " + what, self.current().start, self.current().end);
        }
        self.advance();
    }

    proc primary(&self) -> Node throws Diagnostic {
        token: Token = self.current();
        match token.kind {
            TokenKind.Number | TokenKind.RealNumber | TokenKind.String | TokenKind.Character | TokenKind.True | TokenKind.False | TokenKind.Null | TokenKind.Poison => {
                self.advance();
                return Node(NodeKind.Literal, token.start, token.end, token.kind, List<Node>());
            }
            TokenKind.Identifier => {
                self.advance();
                return Node(NodeKind.Name, token.start, token.end, TokenKind.EndOfFile, List<Node>());
            }
            TokenKind.LeftParen => {
                self.advance();
                expression: Node = self.binary(0);
                self.expect(TokenKind.RightParen, "`)`");
                return expression;
            }
            else => {
                throw Diagnostic("expected an expression", token.start, token.end);
            }
        }
    }

    proc unary(&self) -> Node throws Diagnostic {
        token: Token = self.current();
        match token.kind {
            TokenKind.Minus => {
                self.advance();
                operand: Node = self.unary();
                end: int = operand.end;
                children: List<Node> = List<Node>();
                children.add(give operand);
                return Node(NodeKind.Unary, token.start, end, token.kind, give children);
            }
            TokenKind.Bang => {
                self.advance();
                operand: Node = self.unary();
                end: int = operand.end;
                children: List<Node> = List<Node>();
                children.add(give operand);
                return Node(NodeKind.Unary, token.start, end, token.kind, give children);
            }
            TokenKind.Plus => {
                self.advance();
                return self.unary();
            }
            else => return self.postfix();
        }
    }

    proc postfix(&self) -> Node throws Diagnostic {
        return self.morePostfix(self.primary());
    }

    proc morePostfix(&self, target: Node) -> Node throws Diagnostic {
        if self.current().kind == TokenKind.LeftParen {
            return self.morePostfix(self.call(give target));
        }
        if self.current().kind == TokenKind.Dot {
            return self.morePostfix(self.field(give target));
        }
        return target;
    }

    proc call(&self, target: Node) -> Node throws Diagnostic {
        self.advance();
        start: int = target.start;
        children: List<Node> = List<Node>();
        children.add(give target);
        if self.current().kind != TokenKind.RightParen {
            children.add(self.binary(0));
            while self.current().kind == TokenKind.Comma {
                self.advance();
                children.add(self.binary(0));
            }
        }
        end: int = self.current().end;
        self.expect(TokenKind.RightParen, "`)`");
        return Node(NodeKind.Call, start, end, TokenKind.LeftParen, give children);
    }

    proc field(&self, target: Node) -> Node throws Diagnostic {
        self.advance();
        start: int = target.start;
        children: List<Node> = List<Node>();
        children.add(give target);
        if self.current().kind != TokenKind.Identifier {
            throw Diagnostic("expected a field name after `.`", self.current().start, self.current().end);
        }
        name: Node = Node(NodeKind.Name, self.current().start, self.current().end, TokenKind.EndOfFile, List<Node>());
        end: int = name.end;
        self.advance();
        children.add(give name);
        return Node(NodeKind.Field, start, end, TokenKind.Dot, give children);
    }

    proc binary(&self, level: int) -> Node throws Diagnostic {
        if level > 4 {
            return self.unary();
        }
        return self.moreBinary(level, self.binary(level + 1));
    }
    
    proc moreBinary(&self, level: int, left: Node) -> Node throws Diagnostic {
        kind: TokenKind = self.current().kind;
        if !self.belongsTo(level, kind) {
            return left;
        }
        self.advance();
        start: int = left.start;
        right: Node = self.binary(level + 1);

        if level == 2 && self.belongsTo(2, self.current().kind) {
            throw Diagnostic("comparisons cannot be chained", self.current().start, self.current().end);
        }
        
        end: int = right.end;
        children: List<Node> = List<Node>();
        children.add(give left);
        children.add(give right);
        return self.moreBinary(level, Node(NodeKind.Binary, start, end, kind, give children));
    }

    proc belongsTo(&self, level: int, kind: TokenKind) -> bool {
        match level {
            0 => return kind == TokenKind.OrOr;
            1 => return kind == TokenKind.AndAnd;
            2 => return kind == TokenKind.EqualEqual || kind == TokenKind.NotEqual || kind == TokenKind.Less 
                        || kind == TokenKind.Greater || kind == TokenKind.LessEqual 
                        || kind == TokenKind.GreaterEqual || kind == TokenKind.Spaceship;
            3 => return kind == TokenKind.Plus || kind == TokenKind.Minus;
            4 => return kind == TokenKind.Star || kind == TokenKind.Slash || kind == TokenKind.Percent;
            else => return false;
        }
    }

    proc isAssignment(&self, kind: TokenKind) -> bool {
        match kind {
            TokenKind.Equal => return true;
            TokenKind.PlusEqual => return true;
            TokenKind.MinusEqual => return true;
            TokenKind.StarEqual => return true;
            TokenKind.SlashEqual => return true;
            TokenKind.PercentEqual => return true;
            else => return false;
        }
    }

    proc block(&self) -> Node throws Diagnostic {
        token: Token = self.current();
        if token.kind != TokenKind.LeftBrace {
            throw Diagnostic("expected '{'", token.start, token.end);
        }
        self.advance();
        children: List<Node> = List<Node>();
        while self.current().kind != TokenKind.RightBrace {
            children.add(self.statement());
        }
        end: int = self.current().end;
        self.advance();
        return Node(NodeKind.Block, token.start, end, TokenKind.LeftBrace, give children);
    }

    proc parameters(&self) -> Node throws Diagnostic {
        start: int = self.current().start;
        self.expect(TokenKind.LeftParen, "`(`");
        children: List<Node> = List<Node>();
        if self.current().kind != TokenKind.RightParen {
            parameter: Node = self.parameter();
            children.add(give parameter);
            while self.current().kind == TokenKind.Comma {
                self.advance();
                nextParameter: Node = self.parameter();
                children.add(give nextParameter);
            }
        }
        end: int = self.current().end;
        self.expect(TokenKind.RightParen, "`)`");
        return Node(NodeKind.Parameters, start, end, TokenKind.LeftParen, give children);
    }
    
    proc parameter(&self) -> Node throws Diagnostic {
        token: Token = self.current();
        if token.kind != TokenKind.Identifier {
            throw Diagnostic("expected parameter name", token.start, token.end);
        }
        self.advance();
        nameChildren: List<Node> = List<Node>();
        name: Node = Node(NodeKind.Name, token.start, token.end, TokenKind.Identifier, give nameChildren);
        self.expect(TokenKind.Colon, "`:`");
        type: Node = self.typeName();
        end: int = type.end;
        children: List<Node> = List<Node>();
        children.add(give name);
        children.add(give type);
        return Node(NodeKind.Parameter, token.start, end, TokenKind.Identifier, give children);
    }
    
    proc procedure(&self) -> Node throws Diagnostic {
        token: Token = self.current();
        if token.kind != TokenKind.Proc {
            throw Diagnostic("expected 'proc'", token.start, token.end);
        }
        self.advance();
        nameToken: Token = self.current();
        if nameToken.kind != TokenKind.Identifier {
            throw Diagnostic("expected procedure name", nameToken.start, nameToken.end);
        }
        self.advance();
        children: List<Node> = List<Node>();
        children.add(Node(NodeKind.Name, nameToken.start, nameToken.end, TokenKind.Identifier, List<Node>()));
        children.add(self.parameters());
        if self.current().kind == TokenKind.Arrow {
            self.advance();
            children.add(self.typeName());
        }
        body: Node = self.block();
        end: int = body.end;
        children.add(give body);
        return Node(NodeKind.Proc, token.start, end, TokenKind.Proc, give children);
    }

    proc statement(&self) -> Node throws Diagnostic {
        token: Token = self.current();
        if self.current().kind == TokenKind.Identifier && self.peek(1).kind == TokenKind.Colon {
            return self.declaration();
        }
        match token.kind {
            TokenKind.LeftBrace => return self.block();
            TokenKind.Return => return self.returnStatement();
            TokenKind.If => return self.ifStatement();
            TokenKind.While => return self.whileStatement();
            TokenKind.For => return self.forStatement();
            TokenKind.Continue => return self.jumpStatement();
            TokenKind.Break => return self.jumpStatement();
            else => return self.expressionStatement();
        }
    }

    proc expressionStatement(&self) -> Node throws Diagnostic {
        expression: Node = self.step();
        end: int = self.current().end;
        self.expect(TokenKind.Semicolon, "`;`");
        start: int = expression.start;
        children: List<Node> = List<Node>();
        children.add(give expression);
        return Node(NodeKind.ExpressionStatement, start, end, TokenKind.Semicolon, give children);
    }

    proc returnStatement(&self) -> Node throws Diagnostic {
        token: Token = self.current();
        if token.kind != TokenKind.Return {
            throw Diagnostic("expected 'return'", token.start, token.end);
        }
        self.advance();
        expression: Node = self.binary(0);
        semicolon: Token = self.current();
        if semicolon.kind != TokenKind.Semicolon {
            throw Diagnostic("expected ';'", semicolon.start, semicolon.end);
        }
        self.advance();
        children: List<Node> = List<Node>();
        children.add(give expression);
        return Node(NodeKind.Return, token.start, semicolon.end, TokenKind.Return, give children);
    }

    proc ifStatement(&self) -> Node throws Diagnostic {
        token: Token = self.current();
        if token.kind != TokenKind.If {
            throw Diagnostic("expected 'if'", token.start, token.end);
        }
        self.advance();
        condition: Node = self.binary(0);
        thenBlock: Node = self.block();
        end: int = thenBlock.end;
        children: List<Node> = List<Node>();
        children.add(give condition);
        children.add(give thenBlock);
        if self.current().kind == TokenKind.Else {
            self.advance();
            if self.current().kind == TokenKind.If {
                elseIfNode: Node = self.ifStatement();
                end = elseIfNode.end;
                children.add(give elseIfNode);
            } else {
                elseBlock: Node = self.block();
                end = elseBlock.end;
                children.add(give elseBlock);
            }
        }
        return Node(NodeKind.If, token.start, end, TokenKind.If, give children);
    }

    proc whileStatement(&self) -> Node throws Diagnostic {
        token: Token = self.current();
        if token.kind != TokenKind.While {
            throw Diagnostic("expected 'while'", token.start, token.end);
        }
        self.advance();
        condition: Node = self.binary(0);
        body: Node = self.block();
        end: int = body.end;
        children: List<Node> = List<Node>();
        children.add(give condition);
        children.add(give body);
        return Node(NodeKind.While, token.start, end, TokenKind.While, give children);
    }

    proc forStatement(&self) -> Node throws Diagnostic {
        token: Token = self.current();
        if token.kind != TokenKind.For {
            throw Diagnostic("expected 'for'", token.start, token.end);
        }
        self.advance();
        initializer: Node = self.declaration();
        condition: Node = self.binary(0);
        self.expect(TokenKind.Semicolon, "`;`");
        increment: Node = self.step();
        body: Node = self.block();
        end: int = body.end;
        children: List<Node> = List<Node>();
        children.add(give initializer);
        children.add(give condition);
        children.add(give increment);
        children.add(give body);
        return Node(NodeKind.For, token.start, end, TokenKind.For, give children);
    }

    proc jumpStatement(&self) -> Node throws Diagnostic {
        token: Token = self.current();
        if token.kind != TokenKind.Continue && token.kind != TokenKind.Break {
            throw Diagnostic("expected 'continue' or 'break'", token.start, token.end);
        }
        self.advance();
        semicolon: Token = self.current();
        if semicolon.kind != TokenKind.Semicolon {
            throw Diagnostic("expected ';'", semicolon.start, semicolon.end);
        }
        self.advance();
        end: int = semicolon.end;
        kind: NodeKind = NodeKind.Continue;
        if token.kind == TokenKind.Break {
            kind = NodeKind.Break;
        }
        return Node(kind, token.start, end, token.kind, List<Node>());
    }

    proc step(&self) -> Node throws Diagnostic {
        target: Node = self.binary(0);
        token: Token = self.current();
        kind: TokenKind = token.kind;
        if self.isAssignment(kind) || kind == TokenKind.PlusPlus || kind == TokenKind.MinusMinus {
            if target.kind != NodeKind.Name && target.kind != NodeKind.Field {
                throw Diagnostic("cannot assign to this expression", target.start, target.end);
            }
            self.advance();
            start: int = target.start;
            end: int = token.end;
            children: List<Node> = List<Node>();
            children.add(give target);
            if kind != TokenKind.PlusPlus && kind != TokenKind.MinusMinus {
                value: Node = self.binary(0);
                end = value.end;
                children.add(give value);
            }
            return Node(NodeKind.Assignment, start, end, kind, give children);
        }
        return target;
    }

    proc declaration(&self) -> Node throws Diagnostic {
        token: Token = self.current();
        if token.kind != TokenKind.Identifier {
            throw Diagnostic("expected declaration", token.start, token.end);
        }
        self.advance();
        nameChildren: List<Node> = List<Node>();
        name: Node = Node(NodeKind.Name, token.start, token.end, TokenKind.Identifier, give nameChildren);
        self.expect(TokenKind.Colon, "`:`");
        typeNode: Node = self.typeName();
        self.expect(TokenKind.Equal, "`=`");
        value: Node = self.binary(0);
        end: int = self.current().end;
        self.expect(TokenKind.Semicolon, "`;`");
        children: List<Node> = List<Node>();
        children.add(give name);
        children.add(give typeNode);
        children.add(give value);

        return Node(NodeKind.Declaration, token.start, end, TokenKind.EndOfFile, give children);
    }
    
    proc typeName(&self) -> Node throws Diagnostic {
        token: Token = self.current();
        kind: TokenKind = token.kind;
        if kind == TokenKind.Int || kind == TokenKind.Real || kind == TokenKind.Text || kind == TokenKind.Bool || kind == TokenKind.Trit || kind == TokenKind.Tryte || kind == TokenKind.Identifier {
            self.advance();
            return Node(NodeKind.Type, token.start, token.end, kind, List<Node>());
        }
        throw Diagnostic("expected a type", token.start, token.end);
    }
}
