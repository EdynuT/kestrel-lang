/*
 * Builds the syntax tree (`Node`) from the tokens of the source code.
 *
 * It runs the lexer itself and walks its tokens one at a time, as the
 * lexer walks the characters: `current()` is the token it is looking
 * at, `advance()` moves to the next one and `expect()` requires a
 * kind of token. Operations are read by precedence, so in `1 + 2 * 3`
 * the `*` ends up deeper in the tree than the `+`. Code that does not
 * fit the grammar throws a `Diagnostic`.
 *
 * @since 0.8
 * @author Edynu
 */

use std.collections.List;

use lexer.Token;
use lexer.TokenKind;
use lexer.Lexer;
use diag.Diagnostic;
use parser.Node;
use parser.NodeKind;

public class Parser {
    source: text;
    lexer: Lexer;
    position: int;
    
    public proc Parser(source: text) -> Parser throws Diagnostic {
        lexer: Lexer = Lexer(source);
        lexer.run();
        return Parser { source: source, lexer: give lexer, position: 0};
    }

    public proc current(&self) -> Token {
        return self.lexer.tokens.get(self.position);
    }

    public proc advance(&self) {
        if self.current().kind != TokenKind.EndOfFile {
            self.position++;
        }
    }

    /* Reads the current token if it is `kind`; `what` names it in the error: "`)`". */
    public proc expect(&self, kind: TokenKind, what: text) throws Diagnostic {
        if self.current().kind != kind {
            throw Diagnostic("expected " + what, self.current().start, self.current().end);
        }
        self.advance();
    }

    public proc primary(&self) -> Node throws Diagnostic {
        token: Token = self.current();
        match token.kind {
            TokenKind.Number => {
                self.advance();
                return Node(NodeKind.Number, token.start, token.end, TokenKind.EndOfFile, List<Node>());
            }
            TokenKind.Identifier => {
                self.advance();
                return Node(NodeKind.Name, token.start, token.end, TokenKind.EndOfFile, List<Node>());
            }
            TokenKind.LeftParen => {
                self.advance();
                expression: Node = self.binary(0);
                self.expect(TokenKind.RightParen, ")");
                return expression;
            }
            else => {
                throw Diagnostic("expected an expression", token.start, token.end);
            }
        }
    }


    proc unary(&self) -> Node throws Diagnostic {
        token: Token = self.current();
        match token.kind {
            TokenKind.Minus => {
                self.advance();
                operand: Node = self.unary();
                end: int = operand.end;
                children: List<Node> = List<Node>();
                children.add(give operand);
                return Node(NodeKind.Unary, token.start, end, token.kind, give children);
            }
            TokenKind.Bang => {
                self.advance();
                operand: Node = self.unary();
                end: int = operand.end;
                children: List<Node> = List<Node>();
                children.add(give operand);
                return Node(NodeKind.Unary, token.start, end, token.kind, give children);
            }
            TokenKind.Plus => {
                self.advance();
                return self.unary();
            }
            else => return self.primary();
        }
    }

    proc binary(&self, level: int) -> Node throws Diagnostic {
        if level > 4 {
            return self.unary();
        }
        return self.moreBinary(level, self.binary(level + 1));
    }
    
    proc moreBinary(&self, level: int, left: Node) -> Node throws Diagnostic {
        kind: TokenKind = self.current().kind;
        if !self.belongsTo(level, kind) {
            return left;
        }
        self.advance();
        start: int = left.start;
        right: Node = self.binary(level + 1);

        if level == 2 && self.belongsTo(2, self.current().kind) {
            throw Diagnostic("comparisons cannot be chained", self.current().start, self.current().end);
        }
        
        end: int = right.end;
        children: List<Node> = List<Node>();
        children.add(give left);
        children.add(give right);
        return self.moreBinary(level, Node(NodeKind.Binary, start, end, kind, give children));
    }

    proc belongsTo(&self, level: int, kind: TokenKind) -> bool {
        match level {
            0 => return kind == TokenKind.OrOr;
            1 => return kind == TokenKind.AndAnd;
            2 => return kind == TokenKind.EqualEqual || kind == TokenKind.NotEqual || kind == TokenKind.Less 
                        || kind == TokenKind.Greater || kind == TokenKind.LessEqual 
                        || kind == TokenKind.GreaterEqual || kind == TokenKind.Spaceship;
            3 => return kind == TokenKind.Plus || kind == TokenKind.Minus;
            4 => return kind == TokenKind.Star || kind == TokenKind.Slash || kind == TokenKind.Percent;
            else => return false;
        }
    }
}
