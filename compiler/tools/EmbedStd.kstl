/*
 * Puts the standard library inside the compiler, like the `build.rs` of
 * the `ksc` in Rust: it reads each `.kstl` of `std/` and writes
 * `StdFiles.kstl`, a Kestrel file with one proc, `source(name)`, that
 * returns the text of `std.<name>` (`source("io.Console")`), or null.
 *
 *     tools/EmbedStd src/StdFiles.kstl ../std/io/Console.kstl ../std/text/Texts.kstl ...
 *
 * The first argument is the file to write; the others are the files of
 * the standard library (the shell can list them all with a wildcard).
 * Run it again after changing anything in `std/`.
 *
 * @since 0.9
 * @author Edynu
 */

use std.text.Texts;
use std.io.Console;
use std.io.Files;
use std.os.Process;

proc main() {
    if Process.argCount() < 2 {
        Console.printl("usage: EmbedStd output.kstl std-files...");
        Process.exit(1);
    }

    content: text = "// Copyright (c) 2026 Edynu\n";
    content = content + "// SPDX-License-Identifier: GPL-3.0-or-later\n\n";
    content = content + "/* Generated by EmbedStd; do not edit by hand. */\n\n";
    content = content + "public proc source(name: text) -> text? {\n";
    for i: int = 1; i < Process.argCount(); i++ {
        path: text = Process.arg(i);
        name: text? = moduleName(path);
        if name == null {
            Console.printl("invalid standard library path: " + path);
            Process.exit(1);
        } else {
            content = content + "    if name == \"" + escape(name) + "\" {\n";
            content = content + "        return \"" + escape(Files.read(path)) + "\";\n";
            content = content + "    }\n";
        }
    }
    content = content + "    return null;\n}\n";
    Files.write(Process.arg(0), content);
}

/*
 * The name of a standard library file as a `use` writes it, after `std.`:
 * `../std/io/Console.kstl` is `io.Console` (the folder, a dot and the file
 * without `.kstl`). It is null when the path has no folder or is not a
 * `.kstl` file.
 */
proc moduleName(path: text) -> text? {
    if !Texts.endsWith(path, ".kstl") {
        return null;
    }
    nameEnd: int = len(path) - 5;
    slash: int = nameEnd - 1;
    while slash >= 0 && path[slash] != '/' {
        slash--;
    }
    if slash < 0 || slash + 1 == nameEnd {
        return null;
    }
    directoryStart: int = slash - 1;
    while directoryStart >= 0 && path[directoryStart] != '/' {
        directoryStart--;
    }
    directoryStart++;
    if directoryStart == slash {
        return null;
    }
    return Texts.sub(path, directoryStart, slash) + "." + Texts.sub(path, slash + 1, nameEnd);
}

/*
 * `value` written as the inside of a text literal: a backslash, a quote,
 * a line break, a tab and ESC become their escapes, so that the generated
 * literal reads back as exactly `value`. The backslash comes first, or
 * the backslash of an escape just written would be escaped again.
 */
proc escape(value: text) -> text {
    result: text = "";
    for i: int = 0; i < len(value); i++ {
        character: tryte = value[i];
        if character == '\\' {
            result = result + "\\\\";
        } else if character == '"' {
            result = result + "\\\"";
        } else if character == '\n' {
            result = result + "\\n";
        } else if character == '\t' {
            result = result + "\\t";
        } else if character == '\e' {
            result = result + "\\e";
        } else {
            result = result + Texts.sub(value, i, i + 1);
        }
    }
    return result;
}
