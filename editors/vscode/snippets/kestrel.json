{
  "main": {
    "prefix": "main",
    "body": ["proc main() -> int {", "\t$0", "\treturn 0;", "}"],
    "description": "Ponto de entrada"
  },
  "proc": {
    "prefix": "proc",
    "body": ["proc ${1:nome}(${2}) -> ${3:int} {", "\t$0", "}"],
    "description": "Proc com retorno"
  },
  "proc sem retorno": {
    "prefix": "procv",
    "body": ["proc ${1:nome}(${2}) {", "\t$0", "}"],
    "description": "Proc sem retorno"
  },
  "struct": {
    "prefix": "struct",
    "body": ["struct ${1:Nome} {", "\t${2:campo}: ${3:int};", "}"],
    "description": "Struct (copiado por valor)"
  },
  "enum": {
    "prefix": "enum",
    "body": ["enum ${1:Nome} { ${2:A}, ${3:B} }"],
    "description": "Enum"
  },
  "class": {
    "prefix": "class",
    "body": [
      "class ${1:Nome} {",
      "\t${2:campo}: ${3:int};",
      "",
      "\tpublic proc ${4:novo}(${2:campo}: ${3:int}) -> ${1:Nome} {",
      "\t\treturn ${1:Nome} { ${2:campo}: ${2:campo} };",
      "\t}",
      "$0",
      "}"
    ],
    "description": "Classe com construtor"
  },
  "interface": {
    "prefix": "interface",
    "body": ["interface ${1:Nome} {", "\tproc ${2:metodo}(&self) -> ${3:int};", "}"],
    "description": "Interface"
  },
  "impl": {
    "prefix": "impl",
    "body": [
      "@impl(${1:Interface})",
      "class ${2:Nome} {",
      "\t$0",
      "}"
    ],
    "description": "Classe que implementa uma interface"
  },
  "override": {
    "prefix": "override",
    "body": ["@override", "public proc ${1:metodo}(&self) -> ${2:int} {", "\t$0", "}"],
    "description": "Método que cumpre uma interface"
  },
  "metodo": {
    "prefix": "method",
    "body": ["public proc ${1:metodo}(&self${2}) -> ${3:int} {", "\t$0", "}"],
    "description": "Método que usa o objeto"
  },
  "if": {
    "prefix": "if",
    "body": ["if ${1:condicao} {", "\t$0", "}"],
    "description": "if"
  },
  "if else": {
    "prefix": "ife",
    "body": ["if ${1:condicao} {", "\t$2", "} else {", "\t$0", "}"],
    "description": "if / else"
  },
  "tri": {
    "prefix": "tri",
    "body": ["tri ${1:a} <=> ${2:b} {", "\t- => ${3:print(\"menor\");}", "\t0 => ${4:print(\"igual\");}", "\t+ => ${5:print(\"maior\");}", "}"],
    "description": "Desvio triplo"
  },
  "match": {
    "prefix": "match",
    "body": ["match ${1:valor} {", "\t${2:1} => $3;", "\telse => $0;", "}"],
    "description": "match"
  },
  "walk": {
    "prefix": "walk",
    "body": ["walk ${1:i} in ${2:0}..${3:9} {", "\t$0", "}"],
    "description": "Laço num intervalo"
  },
  "walk span": {
    "prefix": "walks",
    "body": ["walk ${1:i} in span ${2:k} {", "\t$0", "}"],
    "description": "Laço de -k a +k"
  },
  "for": {
    "prefix": "for",
    "body": ["for ${1:i}: int = 0; ${1:i} < len(${2:v}); ${1:i}++ {", "\t$0", "}"],
    "description": "for sobre um array"
  },
  "while": {
    "prefix": "while",
    "body": ["while ${1:condicao} {", "\t$0", "}"],
    "description": "while"
  },
  "on NaT": {
    "prefix": "onnat",
    "body": ["${1:x}: ${2:int} = ${3:conta} on NaT {", "\t${4:printl(\"falhou\");}", "\treturn ${5:-1};", "};"],
    "description": "Conta com tratamento de falha"
  },
  "array": {
    "prefix": "arr",
    "body": ["${1:v}[]: ${2:int} = claim ${3:10};", "$0", "burn ${1:v};"],
    "description": "Array com burn no fim"
  },
  "printf": {
    "prefix": "printf",
    "body": ["printf(\"${1:{x\\}}\\n\");"],
    "description": "printf"
  },
  "printl": {
    "prefix": "printl",
    "body": ["printl(${1});"],
    "description": "printl"
  }
}
